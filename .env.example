# Copy to .env. Never commit real credentials. Paths resolve from the repository.
SFT_PYTHON=./.venv-sft/bin/python
OPSD_PYTHON=./.venv-opsd/bin/python
TRAIN_GPUS=0
EVAL_GPU=0
RAY_ADDRESS=local
ALFWORLD_DATA=./data/alfworld
RETHINK_API_ENDPOINT=${RETHINK_API_ENDPOINT:-}
RETHINK_API_KEY=${RETHINK_API_KEY:-}
RETHINK_API_CONCURRENCY=4
# Optional provider routing. Never commit your real organization/session values.
# OpenCode Go endpoint: https://opencode.ai/inference/go/openai/v1/chat/completions
RETHINK_API_ORG_ID=${RETHINK_API_ORG_ID:-}
RETHINK_API_SESSION=${RETHINK_API_SESSION:-}
# Keep normal proxy settings by default. Set false only if your proxy breaks HTTPS POST.
RETHINK_API_TRUST_ENV=true
HF_TOKEN=${HF_TOKEN:-}
# Optional short writable Ray temporary parent, e.g. /tmp.
# RETHINK_RUNTIME_ROOT=/tmp
